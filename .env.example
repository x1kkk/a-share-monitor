# Linux shell: export the values before starting uvicorn; Python does not load this file automatically.
MOCK_MODE=true
MOCK_WECHAT=false
API_TOKEN=replace-with-a-long-random-secret
HTTP_PROXY=
WECHAT_WEBHOOK_URL=
# Include exact browser origins, not the mainland upstream hostname.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000,https://monitor.example.com
